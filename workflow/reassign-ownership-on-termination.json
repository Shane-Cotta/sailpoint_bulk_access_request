          },
          "method": "get",
          "url": "__API_URL__/access-profiles/v1",
          "urlParams": "filters:owner.id eq \"{{$.trigger.identity.id}}\"\nlimit:1",
          "requestContentType": "json"
        },
        "nextStep": "Recheck Entitlements"
      },
      "Recheck Entitlements": {
        "actionId": "sp:http",
        "type": "action",
        "versionNumber": 3,
        "displayName": "Recheck entitlements the departed identity owns",
        "attributes": {
          "param_authenticationRef": "oauth",
