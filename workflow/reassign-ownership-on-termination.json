          "requestContentType": "json"
        },
        "nextStep": "Anything Left?"
      },
      "Anything Left?": {
        "type": "choice",
        "displayName": "Anything still owned?",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckRoles.body[0].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckAccessProfiles.body[0].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckEntitlements.body[0].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckSources.body[0].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckApps.body[0].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckGovernanceGroups.body[?(@.owner.id == $.trigger.identity.id)].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckIdentityProfiles.body[?(@.owner.id == $.trigger.identity.id)].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          },
          {
            "comparator": "IsPresent",
            "variableA.$": "$.recheckPendingApprovals.body[?(@.assignedTo[0].identityID == $.trigger.identity.id)].id",
            "nextStep": "Stop - Ownership Not Fully Reassigned"
          }
        ],
        "defaultStep": "Done"
      },
      "Stop - Ownership Not Fully Reassigned": {
        "actionId": "sp:operator-failure",
        "type": "failure",
        "displayName": "",
        "failureName": "Ownership not fully reassigned",
        "description": "The departed identity still owns some roles, access profiles, entitlements, sources, apps, governance groups, identity profiles or has pending approvals after the reassignment: a change failed, or they had more than 250 of one kind (for governance groups and identity profiles: theirs weren't among the first 250). Check this run's history, then run the workflow again or reassign the rest by hand."
      },
      "Done": {
        "actionId": "sp:operator-success",
        "type": "success",
        "displayName": ""
      }
