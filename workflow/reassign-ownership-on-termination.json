            "paramType": "1.4",
            "refID": "ee7d2721-10b0-5526-8dd9-82674a30d52a"
          },
          "method": "get",
          "url": "__API_URL__/generic-approvals/v1",
          "urlParams": "approverId:{{$.trigger.identity.id}}\nfilters:status eq \"PENDING\"\nlimit:250",
          "requestContentType": "json"
        },
        "nextStep": "Has Pending Approvals?"
      },
      "Has Pending Approvals?": {
        "type": "choice",
        "displayName": "Any pending approvals?",
        "choiceList": [
          {
            "comparator": "IsPresent",
            "variableA.$": "$.getPendingApprovals.body[?(@.assignedTo[0].identityID == $.trigger.identity.id)].id",
            "nextStep": "Reassign Pending Approvals"
          }
        ],
        "defaultStep": "Recheck Roles"
      },
      "Reassign Pending Approvals": {
        "actionId": "sp:loop:iterator",
        "type": "action",
        "versionNumber": 1,
        "displayName": "Give each pending approval to the new owner",
        "attributes": {
          "input.$": "$.getPendingApprovals.body[?(@.assignedTo[0].identityID == $.trigger.identity.id)]",
          "context.$": "$",
          "start": "Reassign Approval",
          "steps": {
            "Reassign Approval": {
              "actionId": "sp:http",
              "type": "action",
              "versionNumber": 3,
              "displayName": "Reassign the approval",
              "attributes": {
                "param_authenticationRef": "oauth",
                "param_oauth": {
                  "mapping": {
                    "auth_client_id": "clientId",
                    "auth_client_secret": "clientSecret",
                    "auth_credential_location": "credentialLocation",
                    "auth_token_url": "tokenURL"
                  },
                  "paramID": "__PARAMETER_ID__",
                  "paramType": "1.4",
                  "refID": "2a4bbbbe-5b23-5131-b666-2b1a7305e148"
                },
                "method": "post",
                "url": "__API_URL__/generic-approvals/v1/{{$.loop.loopInput.id}}/reassign",
                "requestContentType": "json",
                "jsonRequestBody": {
                  "reassignTo": "{{$.loop.context.defineVariableOwner.newOwnerId}}",
                  "comment": "Reassigned automatically: the approver has left (workflow Reassign Ownership on Termination)."
                }
              },
              "nextStep": "Approval Reassigned"
            },
            "Approval Reassigned": {
              "actionId": "sp:operator-success",
              "type": "success",
              "displayName": ""
            }
          }
        },
        "nextStep": "Recheck Roles"
      },
