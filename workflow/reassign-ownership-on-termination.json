        "type": "action",
        "versionNumber": 1,
        "displayName": "Give each identity profile to the new owner",
        "attributes": {
          "input.$": "$.getOwnedIdentityProfiles.body[?(@.owner.id == $.trigger.identity.id)]",
          "context.$": "$",
          "start": "Patch Identity Profile Owner",
          "steps": {
            "Patch Identity Profile Owner": {
              "actionId": "sp:http",
              "type": "action",
              "versionNumber": 3,
              "displayName": "Set the identity profile's owner",
              "attributes": {
                "param_authenticationRef": "oauth",
                "param_oauth": {
                  "mapping": {
                    "auth_client_id": "clientId",
                    "auth_client_secret": "clientSecret",
                    "auth_credential_location": "credentialLocation",
                    "auth_token_url": "tokenURL"
                  },
                  "paramID": "__PARAMETER_ID__",
                  "paramType": "1.4",
                  "refID": "56191541-aa4a-5cea-8a5e-93ca7a525bc4"
                },
                "method": "patch",
                "url": "__API_URL__/identity-profiles/v1/{{$.loop.loopInput.id}}",
                "requestContentType": "json-patch+json",
                "jsonPatchRequestBody": [
                  {
                    "op": "replace",
                    "path": "/owner",
                    "value": {
                      "type": "IDENTITY",
                      "id": "{{$.loop.context.defineVariableOwner.newOwnerId}}"
                    }
                  }
                ]
              },
              "nextStep": "Identity Profile Reassigned"
            },
            "Identity Profile Reassigned": {
              "actionId": "sp:operator-success",
              "type": "success",
              "displayName": ""
            }
          }
        },
        "nextStep": "Get Pending Approvals"
      },
      "Get Pending Approvals": {
        "actionId": "sp:http",
        "type": "action",
        "versionNumber": 3,
        "displayName": "Find the departed identity's pending approvals",
        "attributes": {
          "param_authenticationRef": "oauth",
